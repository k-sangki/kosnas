{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./**/*.ts", "../src/lib/chat.ts", "../src/lib/poll.ts", "../src/lib/night-api.ts", "../src/lib/us-api.ts", "../src/lib/og-image.ts", "../src/lib/econ-api.ts"]
}
