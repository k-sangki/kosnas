{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "name": "kosnas",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 첫 화면 익명 채팅방(worker/chat-room.ts)과 '오늘의 한 표' 투표함(worker/poll-room.ts).
  // SQLite 저장소라 무료 요금제에서도 쓸 수 있다
  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "POLL", "class_name": "PollRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PollRoom"] }
  ],
  // 배포마다 바뀌는 버전 id. worker/index.ts 가 페이지 엣지 캐시 키에 넣어 새 배포가 옛 페이지를 내지 않게 한다
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kosnas"
    }
  ],
  "routes": [
    { "pattern": "kosnas.com", "custom_domain": true },
    { "pattern": "www.kosnas.com", "custom_domain": true }
  ],
  // 국장 시세 수집(collect-kr.yml)을 정시에 건다. GitHub 예약 실행은 5시간 넘게 늦거나 건너뛰었다(2026-10-26~27).
  // 금융위 시세가 다음 영업일 13시 뒤 올라오므로 월~금 KST 13:20·14:00·14:40·18:10 (UTC로 적는다)
  "triggers": {
    "crons": ["20 4 * * 1-5", "0 5 * * 1-5", "40 5 * * 1-5", "10 9 * * 1-5"]
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://kosnas.com"
  }
}
